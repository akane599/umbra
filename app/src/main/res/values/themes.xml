<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Umbra" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/pk_accent</item>
        <item name="colorOnPrimary">@color/pk_on_accent</item>
        <item name="colorPrimaryContainer">@color/pk_accent_soft</item>
        <item name="colorOnPrimaryContainer">@color/pk_text</item>
        <item name="colorSecondary">@color/pk_accent</item>
        <item name="colorSecondaryContainer">@color/pk_accent_soft</item>
        <item name="colorOnSecondaryContainer">@color/pk_text</item>
        <item name="colorError">@color/pk_danger</item>
        <item name="android:colorBackground">@color/pk_bg</item>
        <item name="colorSurface">@color/pk_surface</item>
        <item name="colorSurfaceContainerLow">@color/pk_surface</item>
        <item name="colorSurfaceContainer">@color/pk_surface</item>
        <item name="colorSurfaceContainerHigh">@color/pk_surface</item>
        <item name="colorSurfaceContainerHighest">@color/pk_surface_high</item>
        <item name="colorOnSurface">@color/pk_text</item>
        <item name="colorOnSurfaceVariant">@color/pk_text_dim</item>
        <item name="colorOutline">@color/pk_outline</item>
        <item name="colorOutlineVariant">@color/pk_outline</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Umbra.Dialog</item>
    </style>

    <style name="Theme.Umbra.Main">
        <item name="android:windowBackground">@color/pk_bg</item>
    </style>

    <style name="ThemeOverlay.Umbra.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurfaceContainerHigh">@color/pk_surface</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.Umbra.Large</item>
    </style>

    <style name="ShapeAppearance.Umbra.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <!-- Text styles -->
    <style name="PK.Text.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/pk_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="PK.Text.Section" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/pk_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="PK.Text.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/pk_text</item>
    </style>
    <style name="PK.Text.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/pk_text_dim</item>
    </style>
    <style name="PK.Text.Mono" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/pk_text</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="PK.SectionLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:textAppearance">@style/PK.Text.Section</item>
    </style>

    <style name="PK.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/pk_surface</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="strokeColor">@color/pk_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
    </style>
</resources>
